# Empty DATABASE_URL uses durable embedded Postgres (development only).
DATABASE_URL=
NABAT_DATA_DIR=./data
APP_URL=http://localhost:3000
SESSION_SECRET=
# Never enable the shared, synthetic demo workspace on a live customer deployment.
ENABLE_DEMO=true
AI_PROVIDER=development
# Production subscription mode: AI_PROVIDER=chatgpt-subscription, ANALYSIS_RUNTIME=external.
# Requires local ChatGPT OAuth and the scoped subscription worker; no AI API key.
ANALYSIS_RUNTIME=inline
NABAT_CHATGPT_DIR=./data/chatgpt
NABAT_SUBSCRIPTION_WORKSPACE_ID=
# Business Workspace Agents mode uses its own workspace token, not an AI API key.
# Set AI_PROVIDER=workspace-agent and ANALYSIS_RUNTIME=workspace-agent after setup.
WORKSPACE_AGENT_TRIGGER_ID=
WORKSPACE_AGENT_ACCESS_TOKEN=
WORKSPACE_AGENT_NABAT_WORKSPACE_ID=
WORKSPACE_AGENT_BUDGET_CONFIRMED=false
# Optional Gateway mode: AI_PROVIDER=gateway, ANALYSIS_RUNTIME=inline.
GATEWAY_MODEL_FREE=openai/gpt-4.1-mini
# Reserved for future paid entitlements; new workspaces always start as Free.
GATEWAY_MODEL_PLUS=openai/gpt-6-luna
GATEWAY_MODEL_PRO=openai/gpt-6.1-sol
GATEWAY_MODEL_ENTERPRISE=openai/gpt-6-astra
AI_MONTHLY_BUDGET_USD=5
# Vercel deployments use automatic OIDC for AI Gateway. A key is optional elsewhere.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
# Production media uses private Vercel Blob or a private S3-compatible bucket.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WORKER_SECRET=
CRON_SECRET=
