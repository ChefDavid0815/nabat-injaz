<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" IgnorableNamespaces="uap rescap">
 <Identity Name="NABAT.Operations" Publisher="CN=NABAT" Version="1.1.0.0" ProcessorArchitecture="ARCHITECTURE"/>
 <Properties><DisplayName>NABAT Operations</DisplayName><PublisherDisplayName>NABAT</PublisherDisplayName><Logo>Assets\Logo.png</Logo></Properties>
 <Resources><Resource Language="en-US"/><Resource Language="ar-AE"/></Resources>
 <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0"/></Dependencies>
 <Applications><Application Id="Operations" Executable="Nabat.Windows.exe" EntryPoint="Windows.FullTrustApplication">
  <uap:VisualElements DisplayName="NABAT Operations" Description="Botanical operations for Windows" BackgroundColor="#153D32" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\Logo.png"/>
  <Extensions><uap:Extension Category="windows.protocol"><uap:Protocol Name="nabat"><uap:DisplayName>NABAT plant identity</uap:DisplayName></uap:Protocol></uap:Extension></Extensions>
 </Application></Applications>
 <Capabilities><rescap:Capability Name="runFullTrust"/><Capability Name="internetClient"/></Capabilities>
</Package>
