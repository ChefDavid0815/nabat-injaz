<Application x:Class="Nabat.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="NabatCanvas" Color="#F7F6EF"/><SolidColorBrush x:Key="NabatGreen" Color="#153D32"/>
  <SolidColorBrush x:Key="NabatTextBrush" Color="#153D32"/><SolidColorBrush x:Key="NabatMutedBrush" Color="#64706B"/>
  <SolidColorBrush x:Key="NabatShellSurface" Color="#153D32"/>
  <SolidColorBrush x:Key="NabatBorder" Color="#E5E8DF"/><SolidColorBrush x:Key="NabatAccent" Color="#AD571D"/>
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="HighContrast">
    <SolidColorBrush x:Key="NabatCanvas" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="NabatShellSurface" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="NabatGreen" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="NabatTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="NabatMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="NabatBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="NabatAccent" Color="{ThemeResource SystemColorHighlightColor}"/>
   </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
 </ResourceDictionary></Application.Resources>
</Application>
