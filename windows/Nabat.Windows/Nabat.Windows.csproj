<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><Platforms>x64;ARM64</Platforms><PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Nabat.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <Content Update="Assets/Nabat.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
    <ProjectReference Include="../Nabat.Core/Nabat.Core.csproj" />
    <Content Include="../../public/images/*.webp" Link="Assets/Images/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WinUI resources are generated build outputs; self-contained publish must carry them. -->
  <Target Name="PublishNabatXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <NabatCompiledXaml Include="$(TargetDir)*.xbf" />
      <NabatResourceIndex Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The WinUI resource index is missing. Rebuild before publishing." />
    <Copy SourceFiles="@(NabatCompiledXaml);@(NabatResourceIndex)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
